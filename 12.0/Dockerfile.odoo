# Copyright 2024 Cetmix OU <https://cetmix.com>
# This image is designed to be used with Cetmix Tower <https://cetmix.com/tower>
# However it can be used for standalone deployments too.
# Parts of both Odoo and OCA Docker files are being used.
#
# Odoo 12.0 – Python 3.8 on Debian Bullseye (aligns with 13.0 tooling, avoids Buster package issues).
# On Mac M1 / arm64, build for production amd64 to avoid gevent source-build: docker build --platform linux/amd64 ...
FROM python:3.8-slim-bullseye

ARG ODOO_VERSION=12.0
ARG DOCKER_ODOO_UID=9999
ARG DOCKER_ODOO_GID=9999
ARG POSTGRES_VERSION=14
ARG TARGETARCH
ENV PIP_NO_CACHE_DIR=1
# The GitHub token for Enterprise is passed as the BuildKit secret "github_token"
# (docker build --secret id=github_token,env=GITHUB_TOKEN ...), never as a build arg
ARG TMP_ADDONS_DIR=/tmp/getaddons

ARG ODOO_EDITION=ce
# Install aws cli. Used for s3 backup management and other aws operations
# Set to "yes" to install
ARG INSTALL_AWS
# Install crudini. Used for editing ini files on the fly
ARG INSTALL_CRUDINI
# Install phonenumbers. Used by peppol and other addons
ARG INSTALL_PHONENUMBERS=yes

SHELL ["/bin/bash", "-xo", "pipefail", "-c"]

ENV LANG=C.UTF-8

# Dependencies per Odoo docs + OCA-style build deps
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -qq --no-install-recommends curl python3-pip libldap2-dev libpq-dev libsasl2-dev \
    python3-dev python3-virtualenv build-essential gnupg npm git \
    libxml2-dev \
    libxslt1-dev \
    libz-dev \
    libxmlsec1-dev \
    libcups2-dev \
    swig \
    libffi-dev \
    pkg-config

# Install wkhtmltopdf (Bullseye package). Use container arch so --platform linux/amd64 on M1 gets amd64 .deb.
RUN WKARCH="$(dpkg --print-architecture)" \
    && case "${WKARCH}" in \
         amd64) WKHTML_SHA256=9c687f0c58cf50e01f2a6375d2e34372f8feeec56a84690ea113d298fccadd98 ;; \
         arm64) WKHTML_SHA256=e73435a82cf21ba0387bfee32a193f221fa43e48dda6ed38b12e4c1b70c69728 ;; \
         *) echo "Unsupported architecture ${WKARCH}"; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bullseye_${WKARCH}.deb" -o /tmp/wkhtml.deb \
    && echo "${WKHTML_SHA256}  /tmp/wkhtml.deb" | sha256sum -c - \
    && apt-get update -qq \
    && dpkg --force-depends -i /tmp/wkhtml.deb \
    && DEBIAN_FRONTEND=noninteractive apt-get install -qq -f --no-install-recommends \
    && rm /tmp/wkhtml.deb

# PostgreSQL client (PGDG for Bullseye)
RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] https://apt-archive.postgresql.org/pub/repos/apt/ bullseye-pgdg main" > /etc/apt/sources.list.d/pgclient.list \
    && apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -qq postgresql-client-${POSTGRES_VERSION}

RUN npm install -g rtlcss

# Install AWS CLI if INSTALL_AWS is set to "yes"
RUN if [ "$INSTALL_AWS" = "yes" ]; then \
        DEBIAN_FRONTEND=noninteractive apt-get install -y awscli; \
    fi

# Install crudini if INSTALL_CRUDINI is set to "yes"
RUN if [ "$INSTALL_CRUDINI" = "yes" ]; then \
        DEBIAN_FRONTEND=noninteractive apt-get install -y crudini; \
    fi

ENV VIRTUAL_ENV=/opt/odoo-venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir "setuptools<58" wheel manifestoo git-aggregator click-odoo

COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

# Install phonenumbers if INSTALL_PHONENUMBERS is set to "yes"
RUN if [ "$INSTALL_PHONENUMBERS" = "yes" ]; then \
    pip3 install phonenumbers; \
    fi

RUN groupadd --gid ${DOCKER_ODOO_GID} odoo && useradd odoo -u ${DOCKER_ODOO_UID} -g ${DOCKER_ODOO_GID} -m -s /bin/bash

COPY ./entrypoint.sh /
COPY wait-for-psql.py /usr/local/bin/wait-for-psql.py

ARG ODOO_HEAD=${ODOO_VERSION}
ARG ODOO_ORG_REPO=odoo/odoo
RUN mkdir /tmp/getodoo \
    && (curl -fsSL https://github.com/$ODOO_ORG_REPO/tarball/$ODOO_HEAD | tar -C /tmp/getodoo -xz) \
    && mv /tmp/getodoo/* /opt/odoo \
    && rmdir /tmp/getodoo

ARG ODOO_EE_REPO=odoo/enterprise
ARG ODOO_HEAD_EE=${ODOO_VERSION}

RUN --mount=type=secret,id=github_token \
    set +x; if [ "$ODOO_EDITION" = "ee" ]; then \
    [ -s /run/secrets/github_token ] || { echo "Secret github_token is required for ODOO_EDITION=ee" >&2; exit 1; }; \
    ee_hdr="$(mktemp)" \
    && trap 'rm -f "$ee_hdr"' EXIT \
    && printf 'Authorization: Bearer %s\n' "$(cat /run/secrets/github_token)" > "$ee_hdr" \
    && mkdir /tmp/getodoo \
    && (curl -fsSL -H "@${ee_hdr}" https://api.github.com/repos/$ODOO_EE_REPO/tarball/$ODOO_HEAD_EE | tar -C /tmp/getodoo -xz) \
    && mv /tmp/getodoo/* /tmp/getodoo/odoo_ee \
    && mv -n /tmp/getodoo/odoo_ee/* /opt/odoo/addons \
    && rm -rf /tmp/getodoo; \
    fi

RUN pip install --no-cache-dir -e /opt/odoo --config-setting=editable-mode=compat

RUN printf "[options]\ndata_dir = /var/lib/odoo\n" > /etc/odoo.conf && chown odoo /etc/odoo.conf

ENV ADDONS_LOCATION=/opt/odoo/addons
RUN mkdir -p $TMP_ADDONS_DIR/addons \
    && chown odoo $ADDONS_LOCATION \
    && mkdir -p /var/lib/odoo && chown odoo /var/lib/odoo

VOLUME ["/var/lib/odoo"]
EXPOSE 8069 8071 8072
ENV ODOO_RC=/etc/odoo.conf
USER odoo
ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
